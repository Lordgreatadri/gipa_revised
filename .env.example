APP_NAME=IOMP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the authoritative database (ADR-0003). Tests use gipa_prod_test
# on the same server (see phpunit.xml). Use a dedicated, non-superuser role.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gipa_prod
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Investor onboarding. Phone code delivery: null | array | mail (non-production only).
PHONE_VERIFICATION_DRIVER=sms

ASSISTANT_DRIVER=offline
ASSISTANT_NAME="GIPA Assistant"
# Set ASSISTANT_DRIVER=openai and OPENAI_API_KEY when the client enables a hosted model.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Database backups. Set a password so archives are encrypted. Point this at
# the directory that contains pg_dump when it is not already on PATH.
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_NOTIFICATION_EMAIL=
# PG_DUMP_BINARY_PATH="C:/Program Files/PostgreSQL/16/bin"
PHONE_VERIFICATION_TTL_MINUTES=10

# Audit (ADR-0009). Empty = no automatic deletion.
AUDIT_RETENTION_DAYS=

# Security headers
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_ENABLED=true


# Required by DefaultSystemUserSeeder. Use unique secrets per environment.
DEFAULT_SYSTEM_USER_NAME=
DEFAULT_SYSTEM_USER_EMAIL=
DEFAULT_SYSTEM_USER_PASSWORD=

# Required by demo role and investor scenario seeders. Never commit populated credentials.
IOMP_SEED_DEMO_DATA=false
DEMO_STAFF_PASSWORD=
DEMO_INVESTOR_PASSWORD=
DEMO_INVESTOR_EMAIL_PATTERN=
DEMO_INVESTOR_COUNT=150
DEMO_SUPER_ADMIN_NAME=
DEMO_SUPER_ADMIN_EMAIL=
DEMO_CONTENT_MANAGER_NAME=
DEMO_CONTENT_MANAGER_EMAIL=
DEMO_DISTRICT_OFFICER_NAME=
DEMO_DISTRICT_OFFICER_EMAIL=
DEMO_FIELD_AGENT_NAME=
DEMO_FIELD_AGENT_EMAIL=
DEMO_REVIEWER_NAME=
DEMO_REVIEWER_EMAIL=
DEMO_INVESTOR_NAME=
DEMO_INVESTOR_EMAIL=

DISTRICT_REVIEW_SLA_HOURS=72
OPPORTUNITY_REVIEW_SLA_HOURS=72
INVESTOR_ONBOARDING_REVIEW_SLA_HOURS=72

# Certificate signing keys must be outside the repository and readable only by the signing process.
CERTIFICATE_ACTIVE_KEY_ID=iomp-mvp-1
CERTIFICATE_SIGNATURE_ALGORITHM=RSA-SHA256
CERTIFICATE_PRIVATE_KEY_PATH=
CERTIFICATE_PUBLIC_KEY_PATH=

# API access JWTs are short-lived. Refresh secrets are opaque, hashed at rest, rotated, and revocable.
# Use a unique high-entropy key per environment; do not reuse APP_KEY in production.
JWT_SIGNING_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

ASSISTANT_DRIVER=offline
ASSISTANT_NAME="GIPA Assistant"
ASSISTANT_TAGLINE="Ask about investment opportunities, sectors, districts and onboarding."
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30

# --- SMS -------------------------------------------------------------------
# Outbound SMS. Frog and Twilio credentials, callback secrets, and balance
# thresholds are entered by an administrator at /admin/sms and stored
# encrypted. Copy the accepted callback URL from that screen into the
# provider console. Messages: /admin/sms/messages. Bulk SMS: /admin/sms/campaigns.
# A dedicated SMS_QUEUE needs its own worker. sms:watch-balances runs daily.
SMS_QUEUE=default

# --- Webhooks ---------------------------------------------------------------
# Secret for the generic spatie/laravel-webhook-client "default" endpoint.
# SMS delivery-report endpoints use per-provider secrets held in the database.
WEBHOOK_CLIENT_SECRET=

# --- Database backups -------------------------------------------------------
# Backups are written to the private "backups" disk (storage/app/backups).
# Set an archive password in production so dumps are encrypted at rest.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
# Fallback recipient for backup health notifications when the above is unset.
IOMP_ADMIN_EMAIL=

#ai assistant creds
#ASSISTANT_DRIVER=openai 
OPENAI_API_KEY=